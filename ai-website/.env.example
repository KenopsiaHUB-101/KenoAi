# KenoAi - Environment Variables Template
# Copy this to .env and fill in your values (sandbox only, never commit .env to git)

# OpenRouter API Key (server only; Get from: https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_key

# Google OAuth Client ID (Get from: https://console.cloud.google.com)
# Create a new OAuth 2.0 Web Application credential
# Authorized JavaScript origins include: http://localhost:5000
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE

# Server Configuration
PORT=5000

# GitHub Connector (repo access for the AI chat)
# Personal access token with "repo" scope - https://github.com/settings/tokens
# The token stays on the server (.env is git-ignored) and is NEVER sent to the browser.
# Use KENOAI_GITHUB_TOKEN if your host already injects a different GITHUB_TOKEN.
KENOAI_GITHUB_TOKEN=your_github_token

# Supabase multi-user cloud sync (server only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
GOOGLE_CLIENT_ID=your_google_oauth_client_id

# Optional: model, proxy base, response size
# KENOAI_MODEL=google/gemma-4-31b-it:free
# KENOAI_API_BASE=https://openrouter.ai/api/v1
# KENOAI_MAX_TOKENS=8192
