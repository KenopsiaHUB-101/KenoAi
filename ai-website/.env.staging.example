# KenoAi staging environment template
# Store real values in your staging host secret manager, never in Git.

NODE_ENV=staging
PORT=5001
PUBLIC_URL=https://staging.example.com

OPENROUTER_API_KEY=staging_openrouter_key
KENOAI_MODEL=google/gemma-4-31b-it:free

# Google OAuth client for staging origins only
GOOGLE_CLIENT_ID=staging_google_client_id
VITE_GOOGLE_CLIENT_ID=staging_google_client_id

# Separate Supabase staging project
SUPABASE_URL=https://staging-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=staging_service_role_key

# Separate GitHub OAuth/token integration for staging
KENOAI_GITHUB_TOKEN=staging_github_token

# Agent capabilities: disabled by default outside staging
KENOAI_AGENT_WRITE=false
KENOAI_AGENT_RUNNER=false
# KENOAI_AGENT_WORKSPACE_ROOT=/srv/kenoai/ai-website